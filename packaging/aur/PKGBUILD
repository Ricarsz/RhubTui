# Maintainer: RhubTui contributors
pkgname=rhubtui
pkgver=0.5.0
pkgrel=1
pkgdesc="USB device viewer and removable drive mounter for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/Ricarsz/RhubTui"
license=('MIT')
depends=('glibc' 'gcc-libs' 'udisks2' 'util-linux')
makedepends=('cargo')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz")
# 本地打包：`make dist` 生成 tarball 后可用 `updpkgsums` 换成真实校验和。
sha256sums=('SKIP')

prepare() {
  cd "rhubtui-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "rhubtui-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --locked
}

check() {
  cd "rhubtui-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --locked
}

package() {
  cd "rhubtui-$pkgver"
  install -Dm755 target/release/rhubtui "$pkgdir/usr/bin/rhubtui"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -d "$pkgdir/usr/share/doc/$pkgname/docs"
  install -m644 docs/*.md "$pkgdir/usr/share/doc/$pkgname/docs/"
}
