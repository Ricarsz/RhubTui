# Read/write access to the 2.4G receiver config channel used by RhubTui.
# The package installs this into /usr/lib/udev/rules.d/; for manual installs
# copy it to /etc/udev/rules.d/ and re-plug the receiver.
KERNEL=="hidraw*", ATTRS{idVendor}=="3837", ATTRS{idProduct}=="3033", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="5253", ATTRS{idProduct}=="1020", MODE="0660", TAG+="uaccess"
